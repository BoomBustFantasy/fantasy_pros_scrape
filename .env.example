# Copy to .env and fill in. .env is gitignored.
# These are the .NET configuration keys the Portainer stack passes straight through,
# the same names the other scrapers use. `docker run --env-file .env` takes this file as is.

ASPNETCORE_ENVIRONMENT=Production
TZ=America/Chicago

# Supabase. The service role key is required: the app refuses to start without it.
Supabase__Url=https://your-project.supabase.co
Supabase__ServiceRoleKey=your_service_role_key

# BetterStack logging (optional; leave blank to log to console/file only)
BetterStack__SourceToken=
BetterStack__Endpoint=https://in.logs.betterstack.com
